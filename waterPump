// =====================================================
// Arduino Uno - Water Pump Continuous Cycle Test
// Pattern: 10s ON -> 2s OFF -> Repeat Continuously
// Relay Pin: Arduino Digital Pin 7
// =====================================================

const int RELAY_PIN = 7; 

void setup() {
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, HIGH); 
  delay(1000); // 1 second start delay
}

void loop() {
  // Turn pump ON for 10 seconds
  digitalWrite(RELAY_PIN, LOW); 
  delay(10000); 

  // Turn pump OFF for 2 seconds
  digitalWrite(RELAY_PIN, HIGH);  
  delay(2000); 
}
